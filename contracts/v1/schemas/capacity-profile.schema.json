{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://new-mud.local/contracts/v1/capacity-profile.schema.json",
  "title": "New_Mud capacity profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "artifact_type",
    "profile_id",
    "profile_version",
    "requirement_ids",
    "source_documents",
    "approval",
    "environment",
    "dataset",
    "load_model",
    "sample_window",
    "thresholds",
    "reporting_percentiles"
  ],
  "properties": {
    "contract_version": {"const": "1"},
    "artifact_type": {"const": "capacity_profile"},
    "profile_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$"},
    "profile_version": {"type": "integer", "minimum": 1},
    "requirement_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Z]+-[0-9]{3}$"}
    },
    "source_documents": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {"enum": ["requirements_v6.md", "docs/new_engine/16_OPERATIONS_TESTING_CONTRACT.md"]}
    },
    "historical_source_documents": {
      "type": "array",
      "uniqueItems": true,
      "items": {"const": "requirements_v5.md"}
    },
    "approval": {"$ref": "#/$defs/approval"},
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["application", "database", "network", "production_build", "redis_enabled"],
      "properties": {
        "application": {"$ref": "#/$defs/compute"},
        "database": {"$ref": "#/$defs/compute"},
        "network": {"const": "same_region"},
        "production_build": {"const": true},
        "redis_enabled": {"type": "boolean"}
      }
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accounts", "characters", "blueprint_revisions", "item_entities"],
      "properties": {
        "accounts": {"type": "integer", "minimum": 10000},
        "characters": {"type": "integer", "minimum": 10000},
        "blueprint_revisions": {"type": "integer", "minimum": 10000},
        "item_entities": {"type": "integer", "minimum": 100000}
      }
    },
    "load_model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "websocket_connections",
        "active_presences",
        "concurrent_combats",
        "auth_requests_per_second",
        "public_chat_messages_per_second"
      ],
      "properties": {
        "websocket_connections": {"type": "integer", "minimum": 200},
        "active_presences": {"type": "integer", "minimum": 100},
        "concurrent_combats": {"type": "integer", "minimum": 25},
        "auth_requests_per_second": {"type": "integer", "minimum": 5},
        "public_chat_messages_per_second": {"type": "integer", "minimum": 20}
      }
    },
    "sample_window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseline_minutes", "burst_minutes"],
      "properties": {
        "baseline_minutes": {"type": "integer", "minimum": 120},
        "burst_minutes": {"type": "integer", "minimum": 5}
      }
    },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "auth_rest_p95_ms",
        "auth_rest_error_rate_percent_lt",
        "action_terminal_p95_ms",
        "public_chat_delivery_p95_ms",
        "state_rebuild_p95_ms",
        "forbidden_baseline_failures"
      ],
      "properties": {
        "auth_rest_p95_ms": {"type": "integer", "maximum": 750, "minimum": 1},
        "auth_rest_error_rate_percent_lt": {"type": "number", "maximum": 1, "exclusiveMinimum": 0},
        "action_terminal_p95_ms": {"type": "integer", "maximum": 300, "minimum": 1},
        "public_chat_delivery_p95_ms": {"type": "integer", "maximum": 500, "minimum": 1},
        "state_rebuild_p95_ms": {"type": "integer", "maximum": 2000, "minimum": 1},
        "forbidden_baseline_failures": {
          "type": "array",
          "minItems": 4,
          "uniqueItems": true,
          "items": {"enum": ["data_inconsistency", "duplicate_settlement", "unhandled_exception", "unplanned_disconnect"]}
        }
      }
    },
    "reporting_percentiles": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": {"enum": ["p50", "p95", "p99"]}
    }
  },
  "$defs": {
    "compute": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vcpu", "memory_gib"],
      "properties": {
        "vcpu": {"type": "integer", "minimum": 4},
        "memory_gib": {"type": "integer", "minimum": 8}
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "basis"],
      "properties": {
        "status": {"enum": ["pending", "approved"]},
        "basis": {"type": "string", "minLength": 1},
        "approved_by": {"type": "string", "minLength": 1},
        "approved_at": {"type": "string", "format": "date-time"}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "approved"}}},
          "then": {"required": ["approved_by", "approved_at"]}
        },
        {
          "if": {"properties": {"status": {"const": "pending"}}},
          "then": {"not": {"anyOf": [{"required": ["approved_by"]}, {"required": ["approved_at"]}]}}
        }
      ]
    }
  }
}
