{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://new-mud.local/contracts/v1/machine-catalog.schema.json",
  "title": "New_Mud machine catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "artifact_type", "requirement_ids", "source_document", "values"],
  "properties": {
    "contract_version": {"const": "1"},
    "artifact_type": {"enum": ["protocol_catalog", "error_code_catalog", "state_catalog"]},
    "requirement_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z]+-[0-9]{3}$"}},
    "source_document": {"type": "string", "pattern": "^docs/new_engine/[0-9]{2}_[A-Z0-9_]+\\.md$"},
    "values": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {"type": ["string", "integer"]}
      }
    }
  }
}
