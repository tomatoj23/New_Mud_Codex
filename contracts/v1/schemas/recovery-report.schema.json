{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://new-mud.local/contracts/v1/recovery-report.schema.json",
  "title": "New_Mud isolated recovery report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "artifact_type",
    "report_id",
    "report_version",
    "requirement_ids",
    "source_documents",
    "evidence_level",
    "release_gate_eligible",
    "execution",
    "backup",
    "databases",
    "metrics",
    "validation",
    "passed"
  ],
  "properties": {
    "contract_version": {"const": "1"},
    "artifact_type": {"const": "recovery_report"},
    "report_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,95}$"},
    "report_version": {"type": "integer", "minimum": 1},
    "requirement_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Z]+-[0-9]{3}$"}
    },
    "source_documents": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "enum": [
          "requirements_v6.md",
          "docs/new_engine/16_OPERATIONS_TESTING_CONTRACT.md"
        ]
      }
    },
    "historical_source_documents": {
      "type": "array",
      "uniqueItems": true,
      "items": {"const": "requirements_v5.md"}
    },
    "evidence_level": {"enum": ["m0_infrastructure", "release_candidate"]},
    "release_gate_eligible": {"type": "boolean"},
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "started_at",
        "completed_at",
        "runner",
        "runner_platform",
        "isolated_database",
        "tool_versions"
      ],
      "properties": {
        "started_at": {"type": "string", "format": "date-time"},
        "completed_at": {"type": "string", "format": "date-time"},
        "runner": {"type": "string", "minLength": 1},
        "runner_platform": {"type": "string", "minLength": 1},
        "isolated_database": {
          "type": "object",
          "additionalProperties": false,
          "required": ["database_name", "created_at", "dropped_at", "deleted"],
          "properties": {
            "database_name": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,62}$"},
            "created_at": {"type": "string", "format": "date-time"},
            "dropped_at": {"type": "string", "format": "date-time"},
            "deleted": {"const": true}
          }
        },
        "tool_versions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["server", "pg_dump", "pg_restore"],
          "properties": {
            "server": {"type": "string", "minLength": 1},
            "pg_dump": {"type": "string", "minLength": 1},
            "pg_restore": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "backup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "sha256",
        "size_bytes",
        "snapshot_exported_at",
        "completed_at",
        "stored_in_repository",
        "retained_after_drill"
      ],
      "properties": {
        "format": {"const": "postgresql_custom"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "size_bytes": {"type": "integer", "minimum": 1},
        "snapshot_exported_at": {"type": "string", "format": "date-time"},
        "completed_at": {"type": "string", "format": "date-time"},
        "stored_in_repository": {"const": false},
        "retained_after_drill": {"const": false}
      }
    },
    "databases": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "restored"],
      "properties": {
        "source": {"$ref": "#/$defs/database_evidence"},
        "restored": {"$ref": "#/$defs/database_evidence"}
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rpo_definition",
        "rto_definition",
        "measured_rpo_minutes",
        "measured_rto_minutes",
        "rpo_minutes_max",
        "rto_minutes_max",
        "within_budget"
      ],
      "properties": {
        "rpo_definition": {"const": "recovery_start_minus_exported_snapshot"},
        "rto_definition": {"const": "recovery_start_to_validation_complete"},
        "measured_rpo_minutes": {"type": "number", "minimum": 0},
        "measured_rto_minutes": {"type": "number", "minimum": 0},
        "rpo_minutes_max": {"type": "integer", "minimum": 1, "maximum": 15},
        "rto_minutes_max": {"type": "integer", "minimum": 1, "maximum": 60},
        "within_budget": {"type": "boolean"}
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_sha256_match",
        "migration_history_match",
        "table_counts_match",
        "tool_major_match",
        "required_scopes"
      ],
      "properties": {
        "schema_sha256_match": {"type": "boolean"},
        "migration_history_match": {"type": "boolean"},
        "table_counts_match": {"type": "boolean"},
        "tool_major_match": {"type": "boolean"},
        "required_scopes": {
          "type": "array",
          "minItems": 5,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/scope_result"}
        }
      }
    },
    "passed": {"type": "boolean"}
  },
  "allOf": [
    {
      "if": {"properties": {"evidence_level": {"const": "m0_infrastructure"}}},
      "then": {"properties": {"release_gate_eligible": {"const": false}}}
    },
    {
      "if": {"properties": {"release_gate_eligible": {"const": true}}},
      "then": {"properties": {"evidence_level": {"const": "release_candidate"}}}
    }
  ],
  "$defs": {
    "database_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "database_name",
        "server_version",
        "schema_sha256",
        "migration_history_sha256",
        "table_counts"
      ],
      "properties": {
        "database_name": {"type": "string", "minLength": 1},
        "server_version": {"type": "string", "minLength": 1},
        "schema_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "migration_history_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "table_counts": {
          "type": "object",
          "propertyNames": {"pattern": "^[A-Za-z0-9_]+\\.[A-Za-z0-9_]+$"},
          "additionalProperties": {"type": "integer", "minimum": 0}
        }
      }
    },
    "scope_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "status", "basis"],
      "properties": {
        "scope": {
          "enum": [
            "accounts",
            "characters",
            "world_topology",
            "content_batches",
            "audit_chain"
          ]
        },
        "status": {"enum": ["verified", "not_implemented", "failed"]},
        "basis": {"type": "string", "minLength": 1}
      }
    }
  }
}
