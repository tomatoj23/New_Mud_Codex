{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://new-mud.local/contracts/v1/source-snapshot.schema.json",
  "title": "New_Mud source snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "artifact_type",
    "requirement_ids",
    "source_snapshot_id",
    "reference_snapshot_id",
    "hash_algorithm",
    "canonicalization",
    "generator",
    "generated_at",
    "source",
    "include_roots",
    "exclude_rules",
    "scan_rules",
    "encoding_summary",
    "file_count",
    "byte_count",
    "files",
    "tree_sha256"
  ],
  "properties": {
    "contract_version": {"const": "1"},
    "artifact_type": {"const": "source_snapshot"},
    "requirement_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Z]+-[0-9]{3}$"}
    },
    "source_snapshot_id": {"type": "string", "pattern": "^xkx100-[a-z0-9-]+-sha256-[0-9a-f]{16}$"},
    "reference_snapshot_id": {"type": "string", "minLength": 1},
    "hash_algorithm": {"const": "sha256"},
    "canonicalization": {"const": "RFC8785-JCS/UTF-8"},
    "generator": {"type": "string", "pattern": "^new-mud-source-contracts/[0-9]+$"},
    "generated_at": {"type": "string", "format": "date-time"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["locator", "description"],
      "properties": {
        "locator": {"type": "string", "pattern": "^operator-supplied:[A-Za-z0-9._-]+$"},
        "description": {"type": "string", "minLength": 1}
      }
    },
    "include_roots": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/path"}},
    "exclude_rules": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "scan_rules": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "encoding_summary": {
      "type": "object",
      "additionalProperties": {"type": "integer", "minimum": 0}
    },
    "file_count": {"type": "integer", "minimum": 1},
    "byte_count": {"type": "integer", "minimum": 1},
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/file"}
    },
    "tree_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))[^\\\\\\u0000-\\u001f]+$"
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "bytes", "encoding"],
      "properties": {
        "path": {"$ref": "#/$defs/path"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "bytes": {"type": "integer", "minimum": 0},
        "encoding": {"enum": ["utf-8", "gb18030", "binary"]}
      }
    }
  }
}
